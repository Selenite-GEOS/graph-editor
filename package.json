{
	"name": "@selenite/graph-editor",
	"version": "1.0.1",
	"homepage": "https://selenite-geos.github.io/docs/developper/components/#graph-editor",
	"packageManager": "pnpm@9.13.2",
	"repository": "github:Selenite-GEOS/graph-editor",
	"license": "MIT",
	"keywords": [
		"selenite",
		"svelte",
		"svelte5",
		"visual-programming",
		"node-editor"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run package",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "npm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"docgen": "typedoc",
		"prepare": "husky"
	},
	"module": "./dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"peerDependencies": {
		"@fortawesome/free-regular-svg-icons": "^6.6.0",
		"@fortawesome/free-solid-svg-icons": "^6.6.0",
		"@selenite/commons": "^1.0.0",
		"svelte": "^5.2.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.20.7",
		"@sveltejs/package": "^2.3.11",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@tailwindcss/postcss": "^4.1.4",
		"@tailwindcss/vite": "^4.1.4",
		"@types/color": "^4.2.0",
		"@types/d3-shape": "^3.1.7",
		"@types/eslint": "^9.6.1",
		"@types/lodash-es": "^4.17.12",
		"@types/node": "^22.15.3",
		"@types/uuid": "^10.0.0",
		"@types/wu": "^2.1.44",
		"daisyui": "^5.0.28",
		"eslint": "^9.25.1",
		"eslint-config-prettier": "^10.1.2",
		"eslint-plugin-svelte": "^3.5.1",
		"globals": "^16.0.0",
		"husky": "^9.1.7",
		"jsdom": "^26.1.0",
		"prettier": "^3.5.3",
		"prettier-plugin-svelte": "^3.3.3",
		"publint": "^0.3.12",
		"svelte-check": "^4.1.6",
		"tailwindcss": "^4.1.4",
		"tslib": "^2.8.1",
		"typedoc": "0.26.11",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.31.0",
		"vite": "^6.3.4",
		"vite-plugin-wasm-pack": "^0.1.12",
		"vitest": "^3.1.2"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"dependencies": {
		"@isomorphic-git/lightning-fs": "^4.6.1",
		"@skeletonlabs/floating-ui-svelte": "^0.3.9",
		"broadcast-channel": "^7.1.0",
		"buffer": "^6.0.3",
		"color": "^4.2.3",
		"d3-shape": "^3.2.0",
		"dexie": "^4.0.11",
		"fast-xml-parser": "^4.5.3",
		"isomorphic-git": "^1.30.1",
		"lodash-es": "^4.17.21",
		"regenerator-runtime": "^0.14.1",
		"rete": "^2.0.5",
		"rete-area-plugin": "^2.1.3",
		"rete-auto-arrange-plugin": "^2.0.2",
		"rete-comment-plugin": "^2.1.0",
		"rete-connection-path-plugin": "^2.0.4",
		"rete-connection-plugin": "^2.0.5",
		"rete-context-menu-plugin": "^2.0.6",
		"rete-engine": "^2.1.1",
		"rete-history-plugin": "^2.1.0",
		"rete-render-utils": "^2.0.3",
		"rete-structures": "^2.0.3",
		"rete-svelte-plugin": "^2.1.0",
		"runed": "^0.25.0",
		"sass": "^1.87.0",
		"svelte-css-vars": "^0.0.3",
		"svelte-fa": "^4.0.4",
		"svelte-floating-ui": "^1.6.2",
		"svelte-persisted-store": "^0.12.0",
		"svelte-portal": "^2.2.1",
		"tailwind-scrollbar": "^4.0.2",
		"uuid": "^11.1.0",
		"wu": "^2.1.0"
	},
	"lint-staged": {
		"*.js": "eslint --cache --fix",
		"*.{js,css,md}": "prettier --write"
	}
}
